# Local development values only. Never use these values in a shared or production environment.
POSTGRES_DB=presensi_dev
POSTGRES_USER=presensi_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000
AI_SERVICE_PORT=8001
AI_SERVICE_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173
# Chosen once by scripts/start-local.py on first launch: edge or central.
PRESENSI_LOCAL_AI_PROFILE=
# Setup choice recorded by scripts/start-local.py: downloaded or skipped.
PRESENSI_LOCAL_MODEL_SETUP=
# Generated locally by scripts/dev.py; provide a private random value in shared environments.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
PRESENSI_DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60
# Set exact production UI origins only; leave empty for same-origin Vite proxy development.
PRESENSI_CORS_ALLOWED_ORIGINS=
PRESENSI_API_MAX_REQUEST_BYTES=16777216
PRESENSI_DEVICE_API_REQUESTS_PER_MINUTE=120
PRESENSI_ENROLLMENT_REQUESTS_PER_MINUTE=10
# Old recognition events are deleted or privacy-redacted by the scheduled retention command.
PRESENSI_RECOGNITION_EVENT_RETENTION_DAYS=90
# Biometric embeddings are encrypted with AES-256-GCM before PostgreSQL storage.
# Generate a 32-byte key and store its base64 value only in ignored .env/secret manager.
PRESENSI_FACE_TEMPLATE_KEYS=
PRESENSI_FACE_TEMPLATE_ACTIVE_KEY_ID=local-v1
PRESENSI_GALLERY_MAX_AGE_SECONDS=300
# Local evaluation model paths/version; place checksum-verified files in models/weights.
PRESENSI_ENROLLMENT_YUNET_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
PRESENSI_ENROLLMENT_SFACE_MODEL_PATH=/models/face_recognition_sface_2021dec.onnx
PRESENSI_ENROLLMENT_MODEL_VERSION=opencv-zoo-sface-2021dec
PRESENSI_ENROLLMENT_DUPLICATE_WARNING_THRESHOLD=0.85
# AI_CENTRAL validates the forwarded device credential against Core API.
PRESENSI_AI_CORE_API_BASE_URL=http://api:8000
PRESENSI_AI_SERVICE_BASE_URL=http://ai-service:8001
PRESENSI_AI_MODELS_DIR=./models/weights
# Generated locally; in production share only through the secret manager.
PRESENSI_AI_CONFIG_SYNC_TOKEN=
# Populated by start-local.py after checksum-pinned models are present; thresholds stay empty until calibrated.
PRESENSI_AI_YUNET_MODEL_PATH=
PRESENSI_AI_SFACE_MODEL_PATH=
PRESENSI_AI_MODEL_VERSION=
PRESENSI_AI_MIN_TOP1_SIMILARITY=
PRESENSI_AI_MIN_TOP1_TOP2_MARGIN=
PRESENSI_AI_INFERENCE_TIMEOUT_SECONDS=5
PRESENSI_AI_RATE_LIMIT_PER_SECOND=10
PRESENSI_AI_RATE_LIMIT_BURST=20
PRESENSI_AI_LIVENESS_ENABLED=false
PRESENSI_AI_LIVENESS_REQUIRED=false
PRESENSI_AI_LIVENESS_MIN_SCORE=
PRESENSI_AI_LIVENESS_MODEL_PATH=
PRESENSI_AI_LIVENESS_MODEL_VERSION=
# Enable only during an authorized local/LAN benchmark; exposes stage timings in response headers.
PRESENSI_AI_BENCHMARK_TIMING_ENABLED=false
