# Local development values only. Never use these values in a shared or production environment.
POSTGRES_DB=presensi_dev
POSTGRES_USER=presensi_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000
AI_SERVICE_PORT=8001
AI_SERVICE_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173
# Generated locally by scripts/dev.py; provide a private random value in shared environments.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
# AI_CENTRAL values remain blank until local models, calibrated thresholds and
# per-device tokens are provisioned. Use random URL-safe tokens of 32+ chars.
PRESENSI_AI_DEVICE_TOKENS=
PRESENSI_AI_MODELS_DIR=./models/weights
PRESENSI_AI_YUNET_MODEL_PATH=
PRESENSI_AI_SFACE_MODEL_PATH=
PRESENSI_AI_MODEL_VERSION=
PRESENSI_AI_MIN_TOP1_SIMILARITY=
PRESENSI_AI_MIN_TOP1_TOP2_MARGIN=
PRESENSI_AI_INFERENCE_TIMEOUT_SECONDS=5
PRESENSI_AI_RATE_LIMIT_PER_SECOND=10
PRESENSI_AI_RATE_LIMIT_BURST=20
PRESENSI_AI_LIVENESS_ENABLED=false
PRESENSI_AI_LIVENESS_REQUIRED=false
PRESENSI_AI_LIVENESS_MIN_SCORE=
PRESENSI_AI_LIVENESS_MODEL_PATH=
PRESENSI_AI_LIVENESS_MODEL_VERSION=
