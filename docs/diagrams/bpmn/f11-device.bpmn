<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DEF_f11-device" targetNamespace="http://presensi/school">
<process id="P_f11-device" name="F-11 Perangkat" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="reg" name="Registrasi device + lab + profile"><incoming>F_s_0</incoming><outgoing>F_reg_1</outgoing></task>
<parallelGateway id="fork" name="Fork"><incoming>F_reg_1</incoming><outgoing>F_fork_2</outgoing><outgoing>F_fork_5</outgoing><outgoing>F_fork_7</outgoing><outgoing>F_fork_9</outgoing></parallelGateway>
<task id="t1a" name="Provision bearer sekali pakai"><incoming>F_fork_2</incoming><outgoing>F_t1a_3</outgoing></task>
<task id="t1b" name="Rotate token + overlap singkat"><incoming>F_t1a_3</incoming><outgoing>F_t1b_4</outgoing></task>
<task id="t2" name="Update registry atau lab assignment"><incoming>F_fork_5</incoming><outgoing>F_t2_6</outgoing></task>
<task id="t3" name="Jeda atau aktifkan kamera: matching berhenti, heartbeat jalan"><incoming>F_fork_7</incoming><outgoing>F_t3_8</outgoing></task>
<task id="t4" name="Nonaktif: revoke kredensial + kamera offline"><incoming>F_fork_9</incoming><outgoing>F_t4_10</outgoing></task>
<parallelGateway id="join" name="Join"><incoming>F_t1b_4</incoming><incoming>F_t2_6</incoming><incoming>F_t3_8</incoming><incoming>F_t4_10</incoming><outgoing>F_join_11</outgoing></parallelGateway>
<endEvent id="e" name="Selesai"><incoming>F_join_11</incoming></endEvent>
<startEvent id="s2" name="Operasi kontinu"><outgoing>F_s2_12</outgoing></startEvent>
<task id="hb" name="Heartbeat + camera_status + latency + metrik"><incoming>F_s2_12</incoming><incoming>F_gal_15</incoming><outgoing>F_hb_13</outgoing></task>
<task id="disc" name="Discover sesi aktif lab ini"><incoming>F_hb_13</incoming><outgoing>F_disc_14</outgoing></task>
<task id="gal" name="Tarik gallery sesi dan kirim recognition-event idempoten"><incoming>F_disc_14</incoming><outgoing>F_gal_15</outgoing></task>
<sequenceFlow id="F_s_0" sourceRef="s" targetRef="reg"></sequenceFlow>
<sequenceFlow id="F_reg_1" sourceRef="reg" targetRef="fork"></sequenceFlow>
<sequenceFlow id="F_fork_2" sourceRef="fork" targetRef="t1a"></sequenceFlow>
<sequenceFlow id="F_t1a_3" sourceRef="t1a" targetRef="t1b"></sequenceFlow>
<sequenceFlow id="F_t1b_4" sourceRef="t1b" targetRef="join"></sequenceFlow>
<sequenceFlow id="F_fork_5" sourceRef="fork" targetRef="t2"></sequenceFlow>
<sequenceFlow id="F_t2_6" sourceRef="t2" targetRef="join"></sequenceFlow>
<sequenceFlow id="F_fork_7" sourceRef="fork" targetRef="t3"></sequenceFlow>
<sequenceFlow id="F_t3_8" sourceRef="t3" targetRef="join"></sequenceFlow>
<sequenceFlow id="F_fork_9" sourceRef="fork" targetRef="t4"></sequenceFlow>
<sequenceFlow id="F_t4_10" sourceRef="t4" targetRef="join"></sequenceFlow>
<sequenceFlow id="F_join_11" sourceRef="join" targetRef="e"></sequenceFlow>
<sequenceFlow id="F_s2_12" sourceRef="s2" targetRef="hb"></sequenceFlow>
<sequenceFlow id="F_hb_13" sourceRef="hb" targetRef="disc"></sequenceFlow>
<sequenceFlow id="F_disc_14" sourceRef="disc" targetRef="gal"></sequenceFlow>
<sequenceFlow id="F_gal_15" sourceRef="gal" targetRef="hb"><conditionExpression xsi:type="tFormalExpression"><![CDATA[lanjutkan]]></conditionExpression></sequenceFlow>
</process>
<bpmndi:BPMNDiagram id="DG_f11-device"><bpmndi:BPMNPlane id="PL_f11-device" bpmnElement="P_f11-device">
<bpmndi:BPMNShape id="S_s" bpmnElement="s"><dc:Bounds x="30" y="30" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_reg" bpmnElement="reg"><dc:Bounds x="240" y="150" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_fork" bpmnElement="fork"><dc:Bounds x="450" y="270" width="60" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t1a" bpmnElement="t1a"><dc:Bounds x="660" y="390" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_t1b" bpmnElement="t1b"><dc:Bounds x="870" y="510" width="140" height="70" /></bpmndi:BPMNShape>
