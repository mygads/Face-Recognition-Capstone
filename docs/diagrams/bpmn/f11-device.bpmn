<bpmndi:BPMNShape id="S_join" bpmnElement="join"><dc:Bounds x="1080" y="630" width="60" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_e" bpmnElement="e"><dc:Bounds x="1290" y="750" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_s2" bpmnElement="s2"><dc:Bounds x="1500" y="1230" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_hb" bpmnElement="hb"><dc:Bounds x="1710" y="1350" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_disc" bpmnElement="disc"><dc:Bounds x="1920" y="1470" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_gal" bpmnElement="gal"><dc:Bounds x="2130" y="1590" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="E_F_s_0" bpmnElement="F_s_0"><di:waypoint xsi:type="dc:Point" x="66" y="48" /><di:waypoint xsi:type="dc:Point" x="240" y="185" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_reg_1" bpmnElement="F_reg_1"><di:waypoint xsi:type="dc:Point" x="380" y="185" /><di:waypoint xsi:type="dc:Point" x="450" y="300" /></bpmndi:BPMNEdge>
