<startEvent id="a1" name="Registrasi device + lab + profile"><outgoing>F_a1_0</outgoing><outgoing>F_a1_3</outgoing><outgoing>F_a1_5</outgoing><outgoing>F_a1_7</outgoing></startEvent>
<task id="a2" name="Provision bearer sekali pakai"><incoming>F_a1_0</incoming><outgoing>F_a2_1</outgoing></task>
<task id="a3" name="Rotate token + overlap singkat"><incoming>F_a2_1</incoming><outgoing>F_a3_2</outgoing></task>
<task id="a4" name="Update registry atau lab assignment"><incoming>F_a1_3</incoming><outgoing>F_a4_4</outgoing></task>
<task id="a5" name="Jeda atau aktifkan kamera: matching berhenti, heartbeat jalan"><incoming>F_a1_5</incoming><outgoing>F_a5_6</outgoing></task>
<task id="a6" name="Nonaktif: revoke kredensial + kamera offline"><incoming>F_a1_7</incoming><outgoing>F_a6_8</outgoing></task>
<endEvent id="e" name="Selesai"><incoming>F_a3_2</incoming><incoming>F_a4_4</incoming><incoming>F_a5_6</incoming><incoming>F_a6_8</incoming></endEvent>
<task id="b1" name="Heartbeat + camera_status + latency + metrik"><incoming>F_b3_11</incoming><outgoing>F_b1_9</outgoing></task>
<task id="b2" name="Discover sesi aktif lab ini"><incoming>F_b1_9</incoming><outgoing>F_b2_10</outgoing></task>
<task id="b3" name="Tarik gallery sesi dan kirim recognition-event idempoten"><incoming>F_b2_10</incoming><outgoing>F_b3_11</outgoing></task>
