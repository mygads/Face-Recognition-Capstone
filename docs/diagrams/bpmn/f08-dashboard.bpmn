<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DEF_f08-dashboard" targetNamespace="http://presensi/school">
<process id="P_f08-dashboard" name="F-08 Live dashboard" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="open" name="Buka dashboard"><incoming>F_s_0</incoming><outgoing>F_open_1</outgoing></task>
<task id="snap" name="Ambil snapshot sesi + roster + record"><incoming>F_open_1</incoming><incoming>F_up_5</incoming><outgoing>F_snap_2</outgoing></task>
<task id="ar" name="Tampilkan panel at-risk: 25 teratas + ambang efektif"><incoming>F_snap_2</incoming><outgoing>F_ar_3</outgoing></task>
<task id="sub" name="Subscribe WebSocket; refresh tiap 2 detik"><incoming>F_ar_3</incoming><incoming>F_still_7</incoming><outgoing>F_sub_4</outgoing></task>
<exclusiveGateway id="up" name="Ada event baru?" gatewayDirection="Exclusive"><incoming>F_sub_4</incoming><outgoing>F_up_5</outgoing><outgoing>F_up_6</outgoing></exclusiveGateway>
<exclusiveGateway id="still" name="Masih pantau?" gatewayDirection="Exclusive"><incoming>F_up_6</incoming><outgoing>F_still_7</outgoing><outgoing>F_still_8</outgoing></exclusiveGateway>
<endEvent id="e" name="Selesai"><incoming>F_still_8</incoming></endEvent>
<sequenceFlow id="F_s_0" sourceRef="s" targetRef="open"></sequenceFlow>
<sequenceFlow id="F_open_1" sourceRef="open" targetRef="snap"></sequenceFlow>
<sequenceFlow id="F_snap_2" sourceRef="snap" targetRef="ar"></sequenceFlow>
<sequenceFlow id="F_ar_3" sourceRef="ar" targetRef="sub"></sequenceFlow>
<sequenceFlow id="F_sub_4" sourceRef="sub" targetRef="up"></sequenceFlow>
<sequenceFlow id="F_up_5" sourceRef="up" targetRef="snap"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_up_6" sourceRef="up" targetRef="still"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_still_7" sourceRef="still" targetRef="sub"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_still_8" sourceRef="still" targetRef="e"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
</process>
<bpmndi:BPMNDiagram id="DG_f08-dashboard"><bpmndi:BPMNPlane id="PL_f08-dashboard" bpmnElement="P_f08-dashboard">
<bpmndi:BPMNShape id="S_s" bpmnElement="s"><dc:Bounds x="30" y="30" width="36" height="36" /></bpmndi:BPMNShape>
