<bpmndi:BPMNEdge id="E_F_thr_6" bpmnElement="F_thr_6"><di:waypoint xsi:type="dc:Point" x="930" y="540" /><di:waypoint xsi:type="dc:Point" x="1080" y="905" /></bpmndi:BPMNEdge>
