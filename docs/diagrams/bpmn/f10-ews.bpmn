<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DEF_f10-ews" targetNamespace="http://presensi/school">
<process id="P_f10-ews" name="F-10 EWS at-risk tahap 1" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="panel" name="Buka panel Siswa perlu perhatian"><incoming>F_s_0</incoming><outgoing>F_panel_1</outgoing></task>
<task id="pol" name="Ambil policy tersimpan atau default 30 hari + absen 20 persen + telat 3x; override query tervalidasi"><incoming>F_panel_1</incoming><outgoing>F_pol_2</outgoing></task>
<task id="aggr" name="Agregat sesi non-cancelled: total + absen + telat + absence_pct"><incoming>F_pol_2</incoming><outgoing>F_aggr_3</outgoing></task>
<exclusiveGateway id="thr" name="absence_pct &gt;= ambang ATAU telat &gt;= ambang?" gatewayDirection="Exclusive"><incoming>F_aggr_3</incoming><outgoing>F_thr_4</outgoing><outgoing>F_thr_6</outgoing></exclusiveGateway>
<task id="clean" name="Bersih: tidak masuk daftar"><incoming>F_thr_4</incoming><outgoing>F_clean_5</outgoing></task>
<task id="flag" name="Flag + reasons + ambang efektif + revisi policy"><incoming>F_thr_6</incoming><outgoing>F_flag_7</outgoing></task>
<task id="fol" name="Catat tindak lanjut manual guru atau BK"><incoming>F_flag_7</incoming><outgoing>F_fol_8</outgoing></task>
<endEvent id="out" name="Catat di luar sistem pada tahap 1"><incoming>F_clean_5</incoming><incoming>F_fol_8</incoming></endEvent>
<sequenceFlow id="F_s_0" sourceRef="s" targetRef="panel"></sequenceFlow>
<sequenceFlow id="F_panel_1" sourceRef="panel" targetRef="pol"></sequenceFlow>
<sequenceFlow id="F_pol_2" sourceRef="pol" targetRef="aggr"></sequenceFlow>
<sequenceFlow id="F_aggr_3" sourceRef="aggr" targetRef="thr"></sequenceFlow>
<sequenceFlow id="F_thr_4" sourceRef="thr" targetRef="clean"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_clean_5" sourceRef="clean" targetRef="out"></sequenceFlow>
<sequenceFlow id="F_thr_6" sourceRef="thr" targetRef="flag"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_flag_7" sourceRef="flag" targetRef="fol"></sequenceFlow>
<sequenceFlow id="F_fol_8" sourceRef="fol" targetRef="out"></sequenceFlow>
</process>
<bpmndi:BPMNDiagram id="DG_f10-ews"><bpmndi:BPMNPlane id="PL_f10-ews" bpmnElement="P_f10-ews">
<bpmndi:BPMNShape id="S_s" bpmnElement="s"><dc:Bounds x="30" y="30" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_panel" bpmnElement="panel"><dc:Bounds x="240" y="150" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_pol" bpmnElement="pol"><dc:Bounds x="450" y="270" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_aggr" bpmnElement="aggr"><dc:Bounds x="660" y="390" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_thr" bpmnElement="thr"><dc:Bounds x="870" y="510" width="60" height="60" /></bpmndi:BPMNShape>
