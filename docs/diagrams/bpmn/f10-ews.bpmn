<bpmndi:BPMNShape id="S_flag" bpmnElement="flag"><dc:Bounds x="1080" y="870" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_fol" bpmnElement="fol"><dc:Bounds x="1290" y="990" width="140" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_out" bpmnElement="out"><dc:Bounds x="1290" y="750" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="E_F_s_0" bpmnElement="F_s_0"><di:waypoint xsi:type="dc:Point" x="66" y="48" /><di:waypoint xsi:type="dc:Point" x="240" y="185" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_panel_1" bpmnElement="F_panel_1"><di:waypoint xsi:type="dc:Point" x="380" y="185" /><di:waypoint xsi:type="dc:Point" x="450" y="305" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_pol_2" bpmnElement="F_pol_2"><di:waypoint xsi:type="dc:Point" x="590" y="305" /><di:waypoint xsi:type="dc:Point" x="660" y="425" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_aggr_3" bpmnElement="F_aggr_3"><di:waypoint xsi:type="dc:Point" x="800" y="425" /><di:waypoint xsi:type="dc:Point" x="870" y="540" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F_thr_4" bpmnElement="F_thr_4"><di:waypoint xsi:type="dc:Point" x="930" y="540" /><di:waypoint xsi:type="dc:Point" x="1080" y="665" /></bpmndi:BPMNEdge>
