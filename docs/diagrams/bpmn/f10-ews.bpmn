<bpmndi:BPMNEdge id="E_F_fol_8" bpmnElement="F_fol_8"><di:waypoint xsi:type="dc:Point" x="1430" y="1025" /><di:waypoint xsi:type="dc:Point" x="1480" y="1025" /><di:waypoint xsi:type="dc:Point" x="1480" y="768" /><di:waypoint xsi:type="dc:Point" x="1326" y="768" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></definitions>
