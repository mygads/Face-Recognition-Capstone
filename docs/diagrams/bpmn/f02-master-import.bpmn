<process id="P_f02-master-import" name="F-02 Master data + import" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="prep" name="Admin siapkan CSV atau XLSX"><incoming>F_s_0</incoming><incoming>F_r413_5</incoming><incoming>F_r422_9</incoming><outgoing>F_prep_1</outgoing></task>
<task id="up" name="Unggah file max 5 MiB, XLSX max 25 MiB"><incoming>F_prep_1</incoming><outgoing>F_up_2</outgoing></task>
<exclusiveGateway id="size" name="Ukuran dan baris lolos? max 10rb" gatewayDirection="Exclusive"><incoming>F_up_2</incoming><outgoing>F_size_3</outgoing><outgoing>F_size_4</outgoing></exclusiveGateway>
<task id="r413" name="Tolak 413 dengan alasan"><incoming>F_size_3</incoming><outgoing>F_r413_5</outgoing></task>
<task id="prev" name="Preview: validasi per baris"><incoming>F_size_4</incoming><outgoing>F_prev_6</outgoing></task>
<exclusiveGateway id="rows" name="Ada baris invalid?" gatewayDirection="Exclusive"><incoming>F_prev_6</incoming><outgoing>F_rows_7</outgoing><outgoing>F_rows_8</outgoing></exclusiveGateway>
<task id="r422" name="Tampilkan error per baris 422"><incoming>F_rows_7</incoming><outgoing>F_r422_9</outgoing></task>
<task id="commit" name="Commit: simpan siswa-kelas-lab"><incoming>F_rows_8</incoming><outgoing>F_commit_10</outgoing></task>
<endEvent id="e" name="Selesai tanpa audit"><incoming>F_commit_10</incoming></endEvent>
