<sequenceFlow id="F_prev_6" sourceRef="prev" targetRef="rows"></sequenceFlow>
<sequenceFlow id="F_rows_7" sourceRef="rows" targetRef="r422"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_rows_8" sourceRef="rows" targetRef="commit"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_r422_9" sourceRef="r422" targetRef="prep"><conditionExpression xsi:type="tFormalExpression"><![CDATA[ulangi]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_commit_10" sourceRef="commit" targetRef="e"></sequenceFlow>
</process>
