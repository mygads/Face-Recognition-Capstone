<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DEF_f01-login" targetNamespace="http://presensi/school">
<process id="P_f01-login" name="F-01 Login" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="input" name="Input email dan password"><incoming>F_s_0</incoming><incoming>F_fail_4</incoming><outgoing>F_input_1</outgoing></task>
<exclusiveGateway id="cred" name="Kredensial valid?" gatewayDirection="Exclusive"><incoming>F_input_1</incoming><outgoing>F_cred_2</outgoing><outgoing>F_cred_3</outgoing></exclusiveGateway>
<task id="fail" name="Gagal: pesan umum tanpa bocorkan akun"><incoming>F_cred_2</incoming><outgoing>F_fail_4</outgoing></task>
<exclusiveGateway id="chg" name="Wajib ganti password?" gatewayDirection="Exclusive"><incoming>F_cred_3</incoming><outgoing>F_chg_5</outgoing><outgoing>F_chg_6</outgoing></exclusiveGateway>
<task id="new" name="Password baru min 12 char"><incoming>F_chg_5</incoming><incoming>F_valid_8</incoming><outgoing>F_new_7</outgoing></task>
<exclusiveGateway id="valid" name="Valid?" gatewayDirection="Exclusive"><incoming>F_new_7</incoming><outgoing>F_valid_8</outgoing><outgoing>F_valid_9</outgoing></exclusiveGateway>
<task id="issue" name="Terbitkan akses 15 mnt dan sesi cookie 24 jam"><incoming>F_chg_6</incoming><incoming>F_valid_9</incoming><outgoing>F_issue_10</outgoing></task>
<task id="dash" name="Masuk dashboard sesuai role"><incoming>F_issue_10</incoming><outgoing>F_dash_11</outgoing></task>
<endEvent id="e" name="Selesai"><incoming>F_dash_11</incoming></endEvent>
<sequenceFlow id="F_s_0" sourceRef="s" targetRef="input"></sequenceFlow>
<sequenceFlow id="F_input_1" sourceRef="input" targetRef="cred"></sequenceFlow>
<sequenceFlow id="F_cred_2" sourceRef="cred" targetRef="fail"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_cred_3" sourceRef="cred" targetRef="chg"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_fail_4" sourceRef="fail" targetRef="input"><conditionExpression xsi:type="tFormalExpression"><![CDATA[ulangi]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_chg_5" sourceRef="chg" targetRef="new"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_chg_6" sourceRef="chg" targetRef="issue"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_new_7" sourceRef="new" targetRef="valid"></sequenceFlow>
<sequenceFlow id="F_valid_8" sourceRef="valid" targetRef="new"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_valid_9" sourceRef="valid" targetRef="issue"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_issue_10" sourceRef="issue" targetRef="dash"></sequenceFlow>
<sequenceFlow id="F_dash_11" sourceRef="dash" targetRef="e"></sequenceFlow>
</process>
