<process id="P_f07-manual" name="F-07 Presensi manual + koreksi" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="pick" name="Guru pilih siswa + status + catatan"><incoming>F_s_0</incoming><outgoing>F_pick_1</outgoing></task>
<exclusiveGateway id="sc" name="Guru pemilik jadwal?" gatewayDirection="Exclusive"><incoming>F_pick_1</incoming><outgoing>F_sc_2</outgoing><outgoing>F_sc_4</outgoing></exclusiveGateway>
<task id="nf" name="404 session_not_found"><incoming>F_sc_2</incoming><outgoing>F_nf_3</outgoing></task>
<endEvent id="enf" name="Selesai"><incoming>F_nf_3</incoming></endEvent>
<exclusiveGateway id="st" name="Sesi berjalan?" gatewayDirection="Exclusive"><incoming>F_sc_4</incoming><outgoing>F_st_5</outgoing><outgoing>F_st_7</outgoing></exclusiveGateway>
<task id="si" name="409 session_inactive"><incoming>F_st_5</incoming><outgoing>F_si_6</outgoing></task>
<endEvent id="esi" name="Selesai"><incoming>F_si_6</incoming></endEvent>
<exclusiveGateway id="sn" name="Siswa dikenal dan di snapshot?" gatewayDirection="Exclusive"><incoming>F_st_7</incoming><outgoing>F_sn_8</outgoing><outgoing>F_sn_10</outgoing></exclusiveGateway>
<task id="nr" name="404 student_not_found atau student_not_in_session_roster"><incoming>F_sn_8</incoming><outgoing>F_nr_9</outgoing></task>
<endEvent id="enr" name="Selesai"><incoming>F_nr_9</incoming></endEvent>
<exclusiveGateway id="dp" name="Record sesi dan siswa sudah ada?" gatewayDirection="Exclusive"><incoming>F_sn_10</incoming><outgoing>F_dp_11</outgoing><outgoing>F_dp_13</outgoing></exclusiveGateway>
<task id="ar" name="409 attendance_already_recorded; FR tak tertimpa"><incoming>F_dp_11</incoming><outgoing>F_ar_12</outgoing></task>
<endEvent id="ear" name="Selesai"><incoming>F_ar_12</incoming></endEvent>
<task id="sv" name="Record manual + audit attendance.manual_marked"><incoming>F_dp_13</incoming><outgoing>F_sv_14</outgoing></task>
<exclusiveGateway id="k" name="Ada kesalahan?" gatewayDirection="Exclusive"><incoming>F_sv_14</incoming><outgoing>F_k_15</outgoing><outgoing>F_k_16</outgoing></exclusiveGateway>
<task id="post" name="POST koreksi + alasan wajib"><incoming>F_k_16</incoming><outgoing>F_post_17</outgoing></task>
<exclusiveGateway id="cs" name="Kasus?" gatewayDirection="Exclusive"><incoming>F_post_17</incoming><outgoing>F_cs_18</outgoing><outgoing>F_cs_19</outgoing><outgoing>F_cs_20</outgoing></exclusiveGateway>
<task id="ca" name="Kasus a: record id + corrected_status"><incoming>F_cs_18</incoming><outgoing>F_ca_22</outgoing></task>
<task id="cb" name="Kasus b: session + student; previous absen turunan"><incoming>F_cs_19</incoming><outgoing>F_cb_23</outgoing></task>
<task id="rj" name="409 session_still_active: pakai tandai manual"><incoming>F_cs_20</incoming><outgoing>F_rj_21</outgoing></task>
<endEvent id="erj" name="Selesai"><incoming>F_rj_21</incoming></endEvent>
<task id="pe" name="pending + audit; record final tidak berubah"><incoming>F_ca_22</incoming><incoming>F_cb_23</incoming><outgoing>F_pe_24</outgoing></task>
<exclusiveGateway id="w" name="Putusan ADMIN?" gatewayDirection="Exclusive"><incoming>F_pe_24</incoming><outgoing>F_w_25</outgoing><outgoing>F_w_26</outgoing><outgoing>F_w_27</outgoing></exclusiveGateway>
<task id="ap" name="Setujui: lock target + terapkan atomik + audit"><incoming>F_w_25</incoming><outgoing>F_ap_28</outgoing></task>
<task id="dn" name="Tolak + decision_note + audit; record tetap"><incoming>F_w_26</incoming><outgoing>F_dn_29</outgoing></task>
<task id="r422" name="422 decision_note wajib"><incoming>F_w_27</incoming><outgoing>F_r422_30</outgoing></task>
<endEvent id="e2" name="Selesai beraudit"><incoming>F_ap_28</incoming><incoming>F_dn_29</incoming><incoming>F_r422_30</incoming></endEvent>
<endEvent id="e" name="Selesai"><incoming>F_k_15</incoming></endEvent>
