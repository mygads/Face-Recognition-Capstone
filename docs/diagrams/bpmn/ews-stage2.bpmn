<task id="ina" name="In-app; kanal luar hanya bila sekolah opt-in"><incoming>F_nt_10</incoming><outgoing>F_ina_11</outgoing></task>
<endEvent id="e" name="Selesai dicatat"><incoming>F_ina_11</incoming><incoming>F_nt_12</incoming></endEvent>
