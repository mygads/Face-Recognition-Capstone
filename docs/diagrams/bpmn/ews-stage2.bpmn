<task id="cat" name="Catat stage + note beraudit"><incoming>F_g1_6</incoming><incoming>F_esc_8</incoming><outgoing>F_cat_9</outgoing></task>
<task id="esc" name="Eskalasi U-04: wali kelas lalu BK"><incoming>F_g1_7</incoming><outgoing>F_esc_8</outgoing></task>
