<process id="P_f12-preview" name="F-12 AI config + preview" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="pub" name="Admin terbitkan AI config revision"><incoming>F_s_0</incoming><outgoing>F_pub_1</outgoing></task>
