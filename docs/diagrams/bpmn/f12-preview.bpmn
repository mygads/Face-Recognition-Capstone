<endEvent id="e3" name="Selesai"><incoming>F_r3_12</incoming></endEvent>
<exclusiveGateway id="sess" name="Masih tanpa sesi aktif?" gatewayDirection="Exclusive"><incoming>F_cam_13</incoming><outgoing>F_sess_14</outgoing><outgoing>F_sess_16</outgoing></exclusiveGateway>
<task id="r4" name="409 preview_gallery_session_active: gunakan snapshot sesi berjalan, bukan preview"><incoming>F_sess_14</incoming><outgoing>F_r4_15</outgoing></task>
<endEvent id="e4" name="Selesai"><incoming>F_r4_15</incoming></endEvent>
<exclusiveGateway id="win" name="Maks 15 mnt sebelum mulai dan sebelum akhir?" gatewayDirection="Exclusive"><incoming>F_sess_16</incoming><outgoing>F_win_17</outgoing><outgoing>F_win_19</outgoing></exclusiveGateway>
<task id="r5" name="404 preview_gallery_unavailable"><incoming>F_win_17</incoming><outgoing>F_r5_18</outgoing></task>
<endEvent id="e5" name="Selesai"><incoming>F_r5_18</incoming></endEvent>
<exclusiveGateway id="tpl" name="Template aktif tersedia?" gatewayDirection="Exclusive"><incoming>F_win_19</incoming><outgoing>F_tpl_20</outgoing><outgoing>F_tpl_22</outgoing></exclusiveGateway>
<task id="r6" name="409 preview_gallery_empty"><incoming>F_tpl_20</incoming><outgoing>F_r6_21</outgoing></task>
<endEvent id="e6" name="Selesai"><incoming>F_r6_21</incoming></endEvent>
<task id="ov" name="Overlay wajah + kandidat tanpa event; frame sekitar 15 fps, status 500 ms"><incoming>F_tpl_22</incoming><outgoing>F_ov_23</outgoing></task>
<endEvent id="e7" name="Selesai"><incoming>F_ov_23</incoming></endEvent>
