<task id="r1" name="Tolak: buka dari komputer AI_EDGE"><incoming>F_host_5</incoming><outgoing>F_r1_6</outgoing></task>
<endEvent id="e1" name="Selesai"><incoming>F_r1_6</incoming></endEvent>
<exclusiveGateway id="prof" name="Profil AI_EDGE?" gatewayDirection="Exclusive"><incoming>F_host_7</incoming><outgoing>F_prof_8</outgoing><outgoing>F_prof_10</outgoing></exclusiveGateway>
<task id="r2" name="409 preview_gallery_profile_unsupported"><incoming>F_prof_8</incoming><outgoing>F_r2_9</outgoing></task>
<endEvent id="e2" name="Selesai"><incoming>F_r2_9</incoming></endEvent>
<exclusiveGateway id="cam" name="Kamera enabled?" gatewayDirection="Exclusive"><incoming>F_prof_10</incoming><outgoing>F_cam_11</outgoing><outgoing>F_cam_13</outgoing></exclusiveGateway>
