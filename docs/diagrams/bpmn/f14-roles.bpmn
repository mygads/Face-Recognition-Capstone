<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<parallelGateway id="fork" name="Fork"><incoming>F_s_0</incoming><outgoing>F_fork_1</outgoing><outgoing>F_fork_4</outgoing><outgoing>F_fork_7</outgoing></parallelGateway>
<task id="g1" name="Guru: buka sesi miliknya + pantau live"><incoming>F_fork_1</incoming><outgoing>F_g1_2</outgoing></task>
<task id="g2" name="Guru: manual + koreksi pending + laporan dan EWS kelasnya"><incoming>F_g1_2</incoming><outgoing>F_g2_3</outgoing></task>
<task id="l1" name="Laboran: enrollment wajah + operasikan device"><incoming>F_fork_4</incoming><outgoing>F_l1_5</outgoing></task>
<task id="l2" name="Laboran: preview pra-sesi AI_EDGE + buka sesi operasional bila perlu"><incoming>F_l1_5</incoming><outgoing>F_l2_6</outgoing></task>
<task id="a1" name="Admin: master + akun + jadwal + policy sesi"><incoming>F_fork_7</incoming><outgoing>F_a1_8</outgoing></task>
<task id="a2" name="Admin: device registry + kredensial + kamera + AI config + policy EWS + audit"><incoming>F_a1_8</incoming><outgoing>F_a2_9</outgoing></task>
<parallelGateway id="join" name="Join"><incoming>F_g2_3</incoming><incoming>F_l2_6</incoming><incoming>F_a2_9</incoming><outgoing>F_join_10</outgoing></parallelGateway>
<endEvent id="e" name="Selesai"><incoming>F_join_10</incoming></endEvent>
