<task id="a3" name="Audit semua perubahan kecuali jadwal dan commit import"><incoming>F_a2_14</incoming><outgoing>F_a3_15</outgoing></task>
<parallelGateway id="join" name="Join"><incoming>F_g5_6</incoming><incoming>F_l4_11</incoming><incoming>F_a3_15</incoming><outgoing>F_join_16</outgoing></parallelGateway>
<endEvent id="e" name="Selesai"><incoming>F_join_16</incoming></endEvent>
