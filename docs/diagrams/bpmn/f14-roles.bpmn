<sequenceFlow id="F_a1_8" sourceRef="a1" targetRef="a2"></sequenceFlow>
<sequenceFlow id="F_a2_9" sourceRef="a2" targetRef="join"></sequenceFlow>
<sequenceFlow id="F_join_10" sourceRef="join" targetRef="e"></sequenceFlow>
</process>
