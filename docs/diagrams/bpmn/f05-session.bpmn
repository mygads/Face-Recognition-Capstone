<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DEF_f05-session" targetNamespace="http://presensi/school">
<process id="P_f05-session" name="F-05 Buka dan tutup sesi" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="elig" name="Jadwal eligible hari ini"><incoming>F_s_0</incoming><outgoing>F_elig_1</outgoing></task>
<exclusiveGateway id="mode" name="Mode guru?" gatewayDirection="Exclusive"><incoming>F_elig_1</incoming><outgoing>F_mode_2</outgoing><outgoing>F_mode_3</outgoing></exclusiveGateway>
<task id="w" name="Worker 10 detik auto-open"><incoming>F_mode_2</incoming><outgoing>F_w_4</outgoing></task>
<exclusiveGateway id="r" name="Roster kelas kosong?" gatewayDirection="Exclusive"><incoming>F_w_4</incoming><outgoing>F_r_5</outgoing><outgoing>F_r_7</outgoing></exclusiveGateway>
<task id="skip" name="Lewati: tanpa sesi"><incoming>F_r_5</incoming><outgoing>F_skip_6</outgoing></task>
<endEvent id="e1" name="Selesai"><incoming>F_skip_6</incoming></endEvent>
<task id="wa" name="Status active; opened_by null"><incoming>F_r_7</incoming><outgoing>F_wa_8</outgoing></task>
<task id="o" name="Guru atau laboran tekan Buka Sesi"><incoming>F_mode_3</incoming><outgoing>F_o_9</outgoing></task>
<task id="tx" name="Transaksi: attendance_sessions + snapshot roster aktif"><incoming>F_o_9</incoming><outgoing>F_tx_10</outgoing></task>
<exclusiveGateway id="g1" name="Manual-open di dalam jendela?" gatewayDirection="Exclusive"><incoming>F_tx_10</incoming><outgoing>F_g1_11</outgoing><outgoing>F_g1_12</outgoing></exclusiveGateway>
<task id="sa" name="Status active"><incoming>F_g1_11</incoming><outgoing>F_sa_13</outgoing></task>
<task id="so" name="Status manual_override"><incoming>F_g1_12</incoming><outgoing>F_so_14</outgoing></task>
<task id="dash" name="Dashboard live aktif; device tarik gallery"><incoming>F_wa_8</incoming><incoming>F_sa_13</incoming><incoming>F_so_14</incoming><incoming>F_cl_18</incoming><outgoing>F_dash_15</outgoing></task>
<exclusiveGateway id="cl" name="Akhir jadwal atau tutup manual?" gatewayDirection="Exclusive"><incoming>F_dash_15</incoming><outgoing>F_cl_16</outgoing><outgoing>F_cl_18</outgoing></exclusiveGateway>
<task id="csd" name="Tutup: hanya berjalan ke closed + closed_at"><incoming>F_cl_16</incoming><outgoing>F_csd_17</outgoing></task>
<endEvent id="e2" name="Selesai"><incoming>F_csd_17</incoming></endEvent>
<sequenceFlow id="F_s_0" sourceRef="s" targetRef="elig"></sequenceFlow>
<sequenceFlow id="F_elig_1" sourceRef="elig" targetRef="mode"></sequenceFlow>
<sequenceFlow id="F_mode_2" sourceRef="mode" targetRef="w"><conditionExpression xsi:type="tFormalExpression"><![CDATA[automatic dan dalam jendela]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_mode_3" sourceRef="mode" targetRef="o"><conditionExpression xsi:type="tFormalExpression"><![CDATA[manual atau di luar jendela]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_w_4" sourceRef="w" targetRef="r"></sequenceFlow>
<sequenceFlow id="F_r_5" sourceRef="r" targetRef="skip"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_skip_6" sourceRef="skip" targetRef="e1"></sequenceFlow>
<sequenceFlow id="F_r_7" sourceRef="r" targetRef="wa"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_wa_8" sourceRef="wa" targetRef="dash"></sequenceFlow>
<sequenceFlow id="F_o_9" sourceRef="o" targetRef="tx"></sequenceFlow>
<sequenceFlow id="F_tx_10" sourceRef="tx" targetRef="g1"></sequenceFlow>
<sequenceFlow id="F_g1_11" sourceRef="g1" targetRef="sa"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_g1_12" sourceRef="g1" targetRef="so"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_sa_13" sourceRef="sa" targetRef="dash"></sequenceFlow>
<sequenceFlow id="F_so_14" sourceRef="so" targetRef="dash"></sequenceFlow>
<sequenceFlow id="F_dash_15" sourceRef="dash" targetRef="cl"></sequenceFlow>
<sequenceFlow id="F_cl_16" sourceRef="cl" targetRef="csd"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_csd_17" sourceRef="csd" targetRef="e2"></sequenceFlow>
<sequenceFlow id="F_cl_18" sourceRef="cl" targetRef="dash"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
</process>
