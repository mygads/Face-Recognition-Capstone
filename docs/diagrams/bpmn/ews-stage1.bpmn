<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DEF_ews-stage1" targetNamespace="http://presensi/school">
<process id="P_ews-stage1" name="EWS tahap 1 berjalan (09.1)" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="panel" name="Buka panel atau API at-risk"><incoming>F_s_0</incoming><outgoing>F_panel_1</outgoing></task>
<exclusiveGateway id="pol" name="Policy tersimpan?" gatewayDirection="Exclusive"><incoming>F_panel_1</incoming><outgoing>F_pol_2</outgoing><outgoing>F_pol_3</outgoing></exclusiveGateway>
<task id="d0" name="Pakai default: 30 hari + 20 persen + 3x"><incoming>F_pol_2</incoming><outgoing>F_d0_4</outgoing></task>
<task id="p1" name="Pakai policy revisi terakhir + audit"><incoming>F_pol_3</incoming><outgoing>F_p1_5</outgoing></task>
<task id="w" name="Override opsional via query tervalidasi"><incoming>F_d0_4</incoming><incoming>F_p1_5</incoming><outgoing>F_w_6</outgoing></task>
<task id="g" name="Agregat sesi non-cancelled dalam jendela"><incoming>F_w_6</incoming><outgoing>F_g_7</outgoing></task>
<exclusiveGateway id="r" name="absence_pct &gt;= ambang ATAU late &gt;= ambang?" gatewayDirection="Exclusive"><incoming>F_g_7</incoming><outgoing>F_r_8</outgoing><outgoing>F_r_9</outgoing></exclusiveGateway>
<task id="b" name="Tidak masuk daftar"><incoming>F_r_8</incoming><outgoing>F_b_11</outgoing></task>
<task id="f" name="Flag + reasons + ambang efektif + policy_revision"><incoming>F_r_9</incoming><outgoing>F_f_10</outgoing></task>
<endEvent id="e" name="Tindak lanjut manual di luar sistem"><incoming>F_f_10</incoming><incoming>F_b_11</incoming></endEvent>
<sequenceFlow id="F_s_0" sourceRef="s" targetRef="panel"></sequenceFlow>
<sequenceFlow id="F_panel_1" sourceRef="panel" targetRef="pol"></sequenceFlow>
<sequenceFlow id="F_pol_2" sourceRef="pol" targetRef="d0"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_pol_3" sourceRef="pol" targetRef="p1"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_d0_4" sourceRef="d0" targetRef="w"></sequenceFlow>
<sequenceFlow id="F_p1_5" sourceRef="p1" targetRef="w"></sequenceFlow>
<sequenceFlow id="F_w_6" sourceRef="w" targetRef="g"></sequenceFlow>
<sequenceFlow id="F_g_7" sourceRef="g" targetRef="r"></sequenceFlow>
<sequenceFlow id="F_r_8" sourceRef="r" targetRef="b"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_r_9" sourceRef="r" targetRef="f"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_f_10" sourceRef="f" targetRef="e"></sequenceFlow>
<sequenceFlow id="F_b_11" sourceRef="b" targetRef="e"></sequenceFlow>
</process>
