<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DEF_f09-reports" targetNamespace="http://presensi/school">
<process id="P_f09-reports" name="F-09 Laporan dan ekspor" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="filt" name="Pilih filter tanggal-kelas-lab-sesi"><incoming>F_s_0</incoming><outgoing>F_filt_1</outgoing></task>
<task id="scope" name="Batasi scope: guru hanya jadwal miliknya"><incoming>F_filt_1</incoming><outgoing>F_scope_2</outgoing></task>
<task id="aggr" name="Agregat session_students + records"><incoming>F_scope_2</incoming><outgoing>F_aggr_3</outgoing></task>
<exclusiveGateway id="rows" name="Baris tanpa record?" gatewayDirection="Exclusive"><incoming>F_aggr_3</incoming><outgoing>F_rows_4</outgoing><outgoing>F_rows_5</outgoing></exclusiveGateway>
<task id="nr" name="Tampilkan not_recorded"><incoming>F_rows_4</incoming><outgoing>F_nr_6</outgoing></task>
<task id="ab" name="Tampilkan absent"><incoming>F_rows_5</incoming><outgoing>F_ab_7</outgoing></task>
<exclusiveGateway id="x" name="Ekspor?" gatewayDirection="Exclusive"><incoming>F_nr_6</incoming><incoming>F_ab_7</incoming><outgoing>F_x_8</outgoing><outgoing>F_x_10</outgoing></exclusiveGateway>
<task id="tbl" name="Tabel paginasi"><incoming>F_x_8</incoming><outgoing>F_tbl_9</outgoing></task>
<endEvent id="e1" name="Selesai"><incoming>F_tbl_9</incoming></endEvent>
<exclusiveGateway id="big" name="Lebih dari 50rb baris?" gatewayDirection="Exclusive"><incoming>F_x_10</incoming><outgoing>F_big_11</outgoing><outgoing>F_big_13</outgoing></exclusiveGateway>
<task id="e413" name="Tolak 413: persempit filter"><incoming>F_big_11</incoming><outgoing>F_e413_12</outgoing></task>
<endEvent id="e2" name="Selesai"><incoming>F_e413_12</incoming></endEvent>
<task id="csv" name="CSV BOM atau XLSX tanpa skor AI + anti formula-injection"><incoming>F_big_13</incoming><outgoing>F_csv_14</outgoing></task>
<task id="dl" name="Unduh"><incoming>F_csv_14</incoming><outgoing>F_dl_15</outgoing></task>
<endEvent id="e3" name="Selesai"><incoming>F_dl_15</incoming></endEvent>
<sequenceFlow id="F_s_0" sourceRef="s" targetRef="filt"></sequenceFlow>
<sequenceFlow id="F_filt_1" sourceRef="filt" targetRef="scope"></sequenceFlow>
<sequenceFlow id="F_scope_2" sourceRef="scope" targetRef="aggr"></sequenceFlow>
<sequenceFlow id="F_aggr_3" sourceRef="aggr" targetRef="rows"></sequenceFlow>
<sequenceFlow id="F_rows_4" sourceRef="rows" targetRef="nr"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Sesi open]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_rows_5" sourceRef="rows" targetRef="ab"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Sesi closed]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_nr_6" sourceRef="nr" targetRef="x"></sequenceFlow>
<sequenceFlow id="F_ab_7" sourceRef="ab" targetRef="x"></sequenceFlow>
<sequenceFlow id="F_x_8" sourceRef="x" targetRef="tbl"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_tbl_9" sourceRef="tbl" targetRef="e1"></sequenceFlow>
<sequenceFlow id="F_x_10" sourceRef="x" targetRef="big"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_big_11" sourceRef="big" targetRef="e413"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_e413_12" sourceRef="e413" targetRef="e2"></sequenceFlow>
<sequenceFlow id="F_big_13" sourceRef="big" targetRef="csv"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_csv_14" sourceRef="csv" targetRef="dl"></sequenceFlow>
<sequenceFlow id="F_dl_15" sourceRef="dl" targetRef="e3"></sequenceFlow>
</process>
