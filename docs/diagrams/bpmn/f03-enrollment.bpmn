<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="DEF_f03-enrollment" targetNamespace="http://presensi/school">
<process id="P_f03-enrollment" name="F-03 Enrollment wajah" isExecutable="false">
<startEvent id="s" name="Mulai"><outgoing>F_s_0</outgoing></startEvent>
<task id="pick" name="Operator pilih siswa"><incoming>F_s_0</incoming><outgoing>F_pick_1</outgoing></task>
<exclusiveGateway id="tpl" name="Status template?" gatewayDirection="Exclusive"><incoming>F_pick_1</incoming><outgoing>F_tpl_2</outgoing><outgoing>F_tpl_3</outgoing></exclusiveGateway>
<task id="rev" name="Revoke SEMUA template aktif batch ini"><incoming>F_tpl_2</incoming><outgoing>F_rev_4</outgoing></task>
<task id="cap" name="Capture 3 sampai 10 frame max 3 MB"><incoming>F_tpl_3</incoming><incoming>F_rev_4</incoming><incoming>F_q_6</incoming><outgoing>F_cap_5</outgoing></task>
<exclusiveGateway id="q" name="Lolos quality gate?" gatewayDirection="Exclusive"><incoming>F_cap_5</incoming><outgoing>F_q_6</outgoing><outgoing>F_q_7</outgoing></exclusiveGateway>
<exclusiveGateway id="min3" name="Minimal 3 diterima?" gatewayDirection="Exclusive"><incoming>F_q_7</incoming><outgoing>F_min3_8</outgoing><outgoing>F_min3_10</outgoing></exclusiveGateway>
<task id="f" name="Gagal: ulangi capture"><incoming>F_min3_8</incoming><outgoing>F_f_9</outgoing></task>
<endEvent id="ef" name="Gagal"><incoming>F_f_9</incoming></endEvent>
<task id="save" name="Simpan maks 5 template AES-256-GCM + model name-version"><incoming>F_min3_10</incoming><outgoing>F_save_11</outgoing></task>
<exclusiveGateway id="dup" name="Mirip siswa lain di atas 0,85?" gatewayDirection="Exclusive"><incoming>F_save_11</incoming><outgoing>F_dup_12</outgoing><outgoing>F_dup_13</outgoing></exclusiveGateway>
<task id="warn" name="Peringatan duplicate: verifikasi manual"><incoming>F_dup_12</incoming><outgoing>F_warn_14</outgoing></task>
<endEvent id="e" name="Selesai dan audit"><incoming>F_dup_13</incoming><incoming>F_warn_14</incoming></endEvent>
<sequenceFlow id="F_s_0" sourceRef="s" targetRef="pick"></sequenceFlow>
<sequenceFlow id="F_pick_1" sourceRef="pick" targetRef="tpl"></sequenceFlow>
<sequenceFlow id="F_tpl_2" sourceRef="tpl" targetRef="rev"><conditionExpression xsi:type="tFormalExpression"><![CDATA[enrolled]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_tpl_3" sourceRef="tpl" targetRef="cap"><conditionExpression xsi:type="tFormalExpression"><![CDATA[not enrolled]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_rev_4" sourceRef="rev" targetRef="cap"></sequenceFlow>
<sequenceFlow id="F_cap_5" sourceRef="cap" targetRef="q"></sequenceFlow>
<sequenceFlow id="F_q_6" sourceRef="q" targetRef="cap"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_q_7" sourceRef="q" targetRef="min3"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_min3_8" sourceRef="min3" targetRef="f"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_f_9" sourceRef="f" targetRef="ef"></sequenceFlow>
<sequenceFlow id="F_min3_10" sourceRef="min3" targetRef="save"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_save_11" sourceRef="save" targetRef="dup"></sequenceFlow>
<sequenceFlow id="F_dup_12" sourceRef="dup" targetRef="warn"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Ya]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_dup_13" sourceRef="dup" targetRef="e"><conditionExpression xsi:type="tFormalExpression"><![CDATA[Tidak]]></conditionExpression></sequenceFlow>
<sequenceFlow id="F_warn_14" sourceRef="warn" targetRef="e"></sequenceFlow>
</process>
<bpmndi:BPMNDiagram id="DG_f03-enrollment"><bpmndi:BPMNPlane id="PL_f03-enrollment" bpmnElement="P_f03-enrollment">
