  usecase "UC6\nBuka dan tutup sesi" as UC6
  usecase "UC7\nPresensi walk-through otomatis" as UC7
  usecase "UC8\nPresensi manual" as UC8
  usecase "UC9\nAjukan koreksi" as UC9
  usecase "UC10\nPantau dashboard live" as UC10
  usecase "UC11\nLaporan dan ekspor" as UC11
  usecase "UC12\nLihat daftar at-risk" as UC12
  usecase "UC13\nAtur ambang EWS" as UC13
  usecase "UC14\nKelola perangkat dan AI config" as UC14
  usecase "UC15\nPreview kamera pra-sesi" as UC15
  usecase "UC16\nAudit tercatat otomatis" as UC16
  usecase "Preview validasi import" as PREV
  usecase "Quality gate capture" as QG
  usecase "Revoke batch dulu" as RB
  usecase "Cek bentrok jadwal" as CB
  usecase "Snapshot roster" as SR
  usecase "Manual override" as MO
  usecase "Auto-open worker" as AO
  usecase "Discovery gallery sesi" as DG
  usecase "Pipeline recognition-core" as PI
  usecase "Simpan recognition event" as SE
  usecase "Retry frontal look" as RF
  usecase "Wajib ganti password" as WP
  usecase "Agregat kehadiran" as AG
  usecase "U-02 Tindak lanjut" as U2
  usecase "U-03 Notifikasi internal" as U3
  usecase "U-04 Eskalasi berjenjang" as U4
  usecase "Terapkan scope akses" as SC
}

ADM -- UC1
ADM -- UC2
ADM -- UC3
ADM -- UC4
ADM -- UC5
ADM -- UC6
ADM -- UC8
ADM -- UC9
ADM -- UC10
ADM -- UC11
