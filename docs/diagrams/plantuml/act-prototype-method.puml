@startuml
' Metode Prototype — docs/proposal/02-metode-prototype.md §2.1
start
:Dengar kebutuhan dan observasi (1);
repeat
  :Bangun prototipe cepat (2);
  :Uji coba ke pengguna (3);
  if (Review: diterima?) then (tidak)
  else (ya, tanpa/with catatan kecil)
    :Catat backlog terukur bila ada;
    :Implementasi final dan hardening (5);
    :Pengujian sistem dan kalibrasi (6);
    if (Uji lolos?) then (tidak)
    else (ya)
    endif
  endif
repeat while (Ditolak review / gagal uji?\nrevisi lalu ulangi siklus) is (ya)
:Deployment dan serah terima (7);
:Evaluasi pasca-pakai (8);
:Kebutuhan baru? bila ya (misal EWS tahap 2)\nputar siklus baru tanpa merombak arsitektur;
stop

note right
  P4 Tidak -> P7 -> P2 = review menolak.
  P8/P9 Tidak -> P7 = uji coba kembali (re-test).
  Kebutuhan baru memutar siklus tanpa
  merombak arsitektur yang diterima.
end note
@enduml
