@startuml
' Metode Prototype — docs/proposal/02-metode-prototype.md §2.1
start
repeat
  :1 Dengar kebutuhan dan observasi;
  repeat
    repeat
      :2 Bangun prototipe cepat;
      :3 Uji coba ke pengguna;
      if (Uji review: diterima?) then (Ya, tanpa catatan)
      elseif (Ya, dengan catatan kecil)
        :Catat backlog terukur;
      elseif (Tidak)
        :Revisi prototipe;
      endif
    repeat while (Uji review: diterima?) is (Tidak)
  :5 Implementasi final dan hardening;
  :6 Pengujian sistem dan kalibrasi;
  if (Uji lolos?) then (Tidak)
    :Revisi prototipe;
  else (Ya)
  endif
repeat while (Uji lolos?) is (Tidak)
:7 Deployment dan serah terima;
:8 Evaluasi pasca-pakai;
if (Ada kebutuhan baru?) then (Ya, misal EWS tahap 2)
else (Tidak)
endif
repeat while (Ada kebutuhan baru?) is (Ya, misal EWS tahap 2)
:Selesai;
stop

note right
  P4 Tidak -> P7 -> P2 = review menolak,
  kembali ke mockup.
  P9 Tidak -> P7 = uji coba kembali (re-test),
  gagal uji -> revisi -> uji ulang.
  P12 Ya -> P1 = kebutuhan baru memutar
  siklus baru.
end note
@enduml
