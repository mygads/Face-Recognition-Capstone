@startuml
' Activity F-07 Presensi manual + koreksi — docs/proposal/05-activity.md §5.7
start
:Guru pilih siswa + status + catatan;
if (Guru pemilik jadwal?) then (Bukan)
  :404 session_not_found;
  stop
else (Ya)
endif
if (Sesi berjalan?) then (Tidak)
  :409 session_inactive;
  stop
else (Ya)
endif
if (Siswa dikenal dan di snapshot?) then (Tidak)
  :404 student_not_found atau student_not_in_session_roster;
  stop
else (Ya)
endif
if (Record sesi dan siswa sudah ada?) then (Ya)
  :409 attendance_already_recorded; FR tak tertimpa;
  stop
else (Tidak)
  :Record manual + audit attendance.manual_marked;
endif
if (Ada kesalahan?) then (Ya)
  :POST koreksi + alasan wajib;
  if (Kasus?) then (ada record)
    :Kasus a: attendance_record_id + corrected_status;
  elseif (tanpa record, sesi tutup) then (ya)
    :Kasus b: session_id + student_id;
    note right: previous = absen turunan
  else (sesi aktif)
    :409 session_still_active; pakai tandai manual;
    stop
  endif
  :pending + audit; record final tidak berubah;
  if (Putusan ADMIN?) then (Setujui)
    :Lock target FOR UPDATE + cek ulang + terapkan atomik + audit;
    note right: kasus b buat AttendanceRecord manual
  elseif (Tolak + decision_note) then (ya)
    :Rejected + audit; record final tetap;
  else (tanpa note)
    :422 decision_note wajib;
    stop
  endif
  :Selesai beraudit;
  stop
else (Tidak)
endif
:Selesai;
stop

note right
  Satu pending aktif per target.
  Pending tak ubah rekap/laporan/EWS sampai approved.
end note
@enduml
