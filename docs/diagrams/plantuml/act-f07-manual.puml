endif
if (Ada kesalahan?) then (Ya)
  :POST koreksi + alasan wajib;
  :pending + audit; record final tidak berubah;
  :Menunggu kebijakan approval; tanpa endpoint putusan;
  stop
else (Tidak)
endif
:Selesai;
stop

