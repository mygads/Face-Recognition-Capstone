# Production example only. Copy to .env.ai-central, replace every placeholder,
# protect it as root:root mode 0600, and store recoverable secrets in the school vault.
PRESENSI_RELEASE_TAG=replace-with-reviewed-git-commit
POSTGRES_IMAGE=postgres:16
POSTGRES_DB=presensi
POSTGRES_USER=presensi_db_owner
POSTGRES_PASSWORD=replace-with-a-random-database-owner-password
PRESENSI_APP_DB_USER=presensi_api
PRESENSI_APP_DB_PASSWORD=replace-with-a-different-random-api-password
PRESENSI_MODELS_DIR=/srv/presensi/models
API_PORT=8000
AI_SERVICE_PORT=8001
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_TTL_MINUTES=15
PRESENSI_DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60
PRESENSI_FACE_TEMPLATE_KEYS={"replace-with-key-id":"replace-with-base64-32-byte-key"}
PRESENSI_FACE_TEMPLATE_ACTIVE_KEY_ID=replace-with-key-id
PRESENSI_CORS_ALLOWED_ORIGINS=
PRESENSI_API_MAX_REQUEST_BYTES=16777216
PRESENSI_DEVICE_API_REQUESTS_PER_MINUTE=120
PRESENSI_ENROLLMENT_REQUESTS_PER_MINUTE=10
PRESENSI_RECOGNITION_EVENT_RETENTION_DAYS=90
PRESENSI_GALLERY_MAX_AGE_SECONDS=300
PRESENSI_ENROLLMENT_YUNET_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
PRESENSI_ENROLLMENT_SFACE_MODEL_PATH=/models/face_recognition_sface_2021dec.onnx
PRESENSI_ENROLLMENT_MODEL_VERSION=replace-with-approved-sface-version
PRESENSI_ENROLLMENT_DUPLICATE_WARNING_THRESHOLD=0.85

# Device authentication is verified online by Core API; do not copy STB tokens here.
PRESENSI_AI_DEVICE_TOKENS=
PRESENSI_AI_CORE_API_BASE_URL=https://attendance.example.edu
PRESENSI_AI_MIN_TOP1_SIMILARITY=
PRESENSI_AI_MIN_TOP1_TOP2_MARGIN=
PRESENSI_AI_INFERENCE_TIMEOUT_SECONDS=5
PRESENSI_AI_RATE_LIMIT_PER_SECOND=10
PRESENSI_AI_RATE_LIMIT_BURST=20
PRESENSI_AI_GALLERY_MAX_AGE_SECONDS=300
PRESENSI_AI_LIVENESS_ENABLED=false
PRESENSI_AI_LIVENESS_REQUIRED=false
PRESENSI_AI_LIVENESS_MIN_SCORE=
PRESENSI_AI_LIVENESS_MODEL_PATH=
PRESENSI_AI_LIVENESS_MODEL_VERSION=
PRESENSI_AI_BENCHMARK_TIMING_ENABLED=false
