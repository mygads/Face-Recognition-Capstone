# Production example only. Copy to .env.ai-central, replace every placeholder,
# protect it as root:root mode 0600, and store recoverable secrets in the school vault.
PRESENSI_RELEASE_TAG=replace-with-reviewed-git-commit
POSTGRES_IMAGE=postgres:16
POSTGRES_DB=presensi
POSTGRES_USER=presensi_db_owner
POSTGRES_PASSWORD=replace-with-a-random-database-owner-password
PRESENSI_APP_DB_USER=presensi_api
PRESENSI_APP_DB_PASSWORD=replace-with-a-different-random-api-password
PRESENSI_MODELS_DIR=/srv/presensi/models
API_PORT=8000
AI_SERVICE_PORT=8001
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_SESSION_TTL_HOURS=24
JWT_SESSION_COOKIE_SECURE=true
PRESENSI_DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60
PRESENSI_FACE_TEMPLATE_KEYS={"replace-with-key-id":"replace-with-base64-32-byte-key"}
PRESENSI_FACE_TEMPLATE_ACTIVE_KEY_ID=replace-with-key-id
PRESENSI_CORS_ALLOWED_ORIGINS=
PRESENSI_API_MAX_REQUEST_BYTES=16777216
PRESENSI_DEVICE_API_REQUESTS_PER_MINUTE=120
PRESENSI_ENROLLMENT_REQUESTS_PER_MINUTE=10
PRESENSI_RECOGNITION_EVENT_RETENTION_DAYS=90
PRESENSI_RETENTION_SWEEP_HOURS=24
PRESENSI_EVENT_FUTURE_SKEW_SECONDS=300
PRESENSI_DEVICE_QUEUE_WARNING_DEPTH=50
PRESENSI_SESSION_DASHBOARD_POLL_SECONDS=2
PRESENSI_AUTH_LOGIN_EMAIL_ATTEMPTS_PER_MINUTE=10
PRESENSI_AUTH_LOGIN_IP_ATTEMPTS_PER_MINUTE=120
# KAI-scale DB guards: small pool for single-PC labs; raise POOL_SIZE on central.
# POOL_DISABLED=1 only behind PgBouncer (transaction pooling → app uses NullPool).
PRESENSI_DB_POOL_SIZE=5
PRESENSI_DB_MAX_OVERFLOW=10
PRESENSI_DB_POOL_TIMEOUT=30
PRESENSI_DB_POOL_RECYCLE=1800
PRESENSI_DB_STATEMENT_TIMEOUT_MS=30000
PRESENSI_DB_POOL_DISABLED=false
PRESENSI_GALLERY_MAX_AGE_SECONDS=300
PRESENSI_ENROLLMENT_YUNET_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
PRESENSI_ENROLLMENT_SFACE_MODEL_PATH=/models/face_recognition_sface_2021dec.onnx
PRESENSI_ENROLLMENT_MODEL_VERSION=replace-with-approved-sface-version
PRESENSI_ENROLLMENT_DUPLICATE_WARNING_THRESHOLD=0.85
# Enrollment face-quality gates; values mirror the API code defaults.
PRESENSI_ENROLLMENT_MIN_FACE_PIXELS=80
PRESENSI_ENROLLMENT_MIN_SHARPNESS=45.0
PRESENSI_ENROLLMENT_MIN_BRIGHTNESS=25.0
PRESENSI_ENROLLMENT_MAX_BRIGHTNESS=235.0

# Device authentication is verified online by Core API; do not copy STB tokens here.
PRESENSI_AI_DEVICE_TOKENS=
PRESENSI_AI_CORE_API_BASE_URL=https://attendance.example.edu
# Generate once in the secret manager; provide the same value to Core API and AI Central.
PRESENSI_AI_CONFIG_SYNC_TOKEN=replace-with-at-least-32-random-bytes
PRESENSI_AI_MIN_TOP1_SIMILARITY=
PRESENSI_AI_MIN_TOP1_TOP2_MARGIN=
PRESENSI_AI_YUNET_SCORE_THRESHOLD=0.9
PRESENSI_AI_YUNET_NMS_THRESHOLD=0.3
# Burst-consensus profile: the STB gateway mints a fresh track id per burst,
# so consensus must be reachable inside ONE burst of at most MAX_FRAMES.
# Keep ceil(MAX_FRAMES / SAMPLE_EVERY_N_FRAMES) >= MINIMUM_AGREEING_FRAMES
# (default 5/1 -> 5 evaluated >= 3 required); otherwise the service refuses
# to start instead of collecting forever with no attendance. BEST/HISTORY
# only average the frames a burst actually carries.
PRESENSI_AI_MAX_FRAMES=5
PRESENSI_AI_MINIMUM_AGREEING_FRAMES=3
PRESENSI_AI_SAMPLE_EVERY_N_FRAMES=1
PRESENSI_AI_BEST_FRAME_COUNT=5
PRESENSI_AI_MAX_HISTORY_FRAMES=10
# AI service payload/quality guards; values mirror the ai-service code defaults.
# Tune only after local calibration; oversized frames are rejected (413), tiny/
# blurry/dark faces are skipped before matching.
PRESENSI_AI_MAX_REQUEST_BYTES=20971520
PRESENSI_AI_MAX_FRAME_BYTES=3145728
PRESENSI_AI_MAX_IMAGE_WIDTH=4096
PRESENSI_AI_MAX_IMAGE_HEIGHT=4096
PRESENSI_AI_MAX_IMAGE_PIXELS=16000000
PRESENSI_AI_MIN_FACE_PIXELS=80
PRESENSI_AI_MIN_LAPLACIAN_VARIANCE=45.0
PRESENSI_AI_MIN_BRIGHTNESS=25.0
PRESENSI_AI_MAX_BRIGHTNESS=235.0
PRESENSI_AI_INFERENCE_TIMEOUT_SECONDS=5
PRESENSI_AI_RATE_LIMIT_PER_SECOND=10
PRESENSI_AI_RATE_LIMIT_BURST=20
PRESENSI_AI_GALLERY_MAX_AGE_SECONDS=300
PRESENSI_AI_LIVENESS_ENABLED=false
PRESENSI_AI_LIVENESS_REQUIRED=false
PRESENSI_AI_LIVENESS_MIN_SCORE=
PRESENSI_AI_LIVENESS_MODEL_PATH=
PRESENSI_AI_LIVENESS_MODEL_VERSION=
PRESENSI_AI_BENCHMARK_TIMING_ENABLED=false
